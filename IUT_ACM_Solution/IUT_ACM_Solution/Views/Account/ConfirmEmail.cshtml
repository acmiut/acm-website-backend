@model bool
@{
    ViewData["Title"] = "Email Confirmation";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-body text-center">
            @if (Model)
            {
                <h2 class="text-success">✅ Email Confirmed Successfully!</h2>
                <p>Your email has been verified. You can now log in to your account.</p>
                <a class="btn btn-primary" href="/Account/Login">Go to Login</a>
            }
            else
            {
                <h2 class="text-danger">❌ Email Confirmation Failed</h2>
                <p>We couldn't verify your email. The link may be invalid or expired.</p>
                <a class="btn btn-secondary" href="/Account/ResendConfirmation">Resend Confirmation Email</a>
            }
        </div>
    </div>
</div>