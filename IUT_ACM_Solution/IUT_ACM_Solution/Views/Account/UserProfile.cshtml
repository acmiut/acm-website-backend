@using IUT_ACM_Solution.DTOs
@model UserProfileDto
@{
    ViewData["Title"] = "User Profile";
}

<h2>User Profile</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="UserProfile" method="post">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StudentNumber"></label>
        <input asp-for="StudentNumber" class="form-control" />
        <span asp-validation-for="StudentNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EntryYear"></label>
        <input asp-for="EntryYear" class="form-control" />
        <span asp-validation-for="EntryYear" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EducationLevel"></label>
        <input asp-for="EducationLevel" class="form-control" readonly />
        <span asp-validation-for="EducationLevel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="University"></label>
        <input asp-for="University" class="form-control" />
        <span asp-validation-for="University" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TelegramId"></label>
        <input asp-for="TelegramId" class="form-control" />
        <span asp-validation-for="TelegramId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update Profile</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}