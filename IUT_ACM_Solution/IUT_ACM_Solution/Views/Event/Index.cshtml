@{
    ViewData["Title"] = "Events";
}
@model IEnumerable<IUT_ACM_Solution.Models.Event>

<h1>Events</h1>

<p>
    <a asp-action="AddEvent">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EndDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    <a asp-action="UpdateEvent" asp-route-eventId="@item.Id">Edit</a> |
                    <a asp-action="GetEventById" asp-route-eventId="@item.Id">Details</a> |
                    <a asp-action="DeleteEvent" asp-route-eventId="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>