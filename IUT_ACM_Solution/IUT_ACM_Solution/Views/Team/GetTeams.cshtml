@{
    ViewData["Title"] = "Teams";
}
@model IEnumerable<IUT_ACM_Solution.Models.Team>

<h1>Teams</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TeamName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TeamMemberEmails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HasPaid)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamName)
                </td>
                <td>
                    @string.Join(", ", item.TeamMemberEmails)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HasPaid)
                </td>
                <td>
                    <a asp-action="UpdateTeam" asp-route-teamId="@item.Id">Edit</a> |
                    <a asp-action="DeleteTeam" asp-route-teamId="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>