@{
    ViewData["Title"] = "Register Team";
}
@model IUT_ACM_Solution.DTOs.TeamDto

<h1>Register Team for Event</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="RegisterTeam" asp-route-eventId="@ViewBag.EventId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TeamName" class="control-label"></label>
                <input asp-for="TeamName" class="form-control" />
                <span asp-validation-for="TeamName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamMemberEmails" class="control-label"></label>
                <input asp-for="TeamMemberEmails" class="form-control" placeholder="Enter emails separated by commas" />
                <span asp-validation-for="TeamMemberEmails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Register" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="Event">Back to Events</a>
</div>