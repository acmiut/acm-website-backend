@model IUT_ACM_Solution.ViewModels.TeamRegisterationViewModel

@{
    ViewData["Title"] = "Register Team";
}

<h2>Register for @Model.EventTitle</h2>
<p><strong>Fee:</strong> @Model.Fee</p>

<form asp-action="Register" method="post">
    <input type="hidden" asp-for="EventId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Team.TeamName"></label>
        <input asp-for="Team.TeamName" class="form-control" />
        <span asp-validation-for="Team.TeamName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Team Member Emails</label>
        <textarea asp-for="Team.TeamMemberEmails" class="form-control" rows="4" placeholder="Enter one email per line"></textarea>
        <span asp-validation-for="Team.TeamMemberEmails" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Proceed to Payment</button>
    <a asp-controller="Event" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-secondary">Back to Event</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}