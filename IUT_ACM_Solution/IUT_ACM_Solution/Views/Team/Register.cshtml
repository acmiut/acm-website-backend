@model IUT_ACM_Solution.DTOs.TeamDto
@{
    ViewData["Title"] = "Register Team";
    var eventInfo = ViewBag.Event as IUT_ACM_Solution.Models.Event;
}

<h2>Register for @eventInfo?.Title</h2>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="TeamName"></label>
        <input asp-for="TeamName" class="form-control" />
        <span asp-validation-for="TeamName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Team Member Emails</label>
        <textarea asp-for="TeamMemberEmails" class="form-control" rows="4" placeholder="Enter one email per line"></textarea>
        <span asp-validation-for="TeamMemberEmails" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Proceed to Payment</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}